# Copy this file to .env in the backend folder and fill in your Supabase values.
# Never commit .env to Git.

# --- OPTION A: Direct connection ---
# Supabase → Project Settings → Database → Connection string → URI
# Add jdbc: prefix:
# DATABASE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=your_supabase_database_password

# --- OPTION B: Session pooler (recommended if direct connection fails) ---
# Supabase → Project Settings → Database → Connection string → Session pooler
# Use the pooler host and the username format postgres.YOUR_PROJECT_REF
DATABASE_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.YOUR_PROJECT_REF
DATABASE_PASSWORD=your_supabase_database_password

# Auth — use a long random string (at least 32 characters)
JWT_SECRET=clientflow-local-dev-jwt-secret-change-me-32chars

# Frontend URL for CORS (React app runs on port 5173 by default)
CORS_ORIGIN=http://localhost:5173
